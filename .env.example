# Copy to `.env` and fill in. Values are read at build time for NEXT_PUBLIC_*.

# PostgreSQL / Neon (server-only)
DATABASE_URL=
NEON_DATABASE_URL=

# Public site
NEXT_PUBLIC_SITE_URL=https://www.rackandstack.in
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Analytics & tracking -------------------------------------------------

# Google Tag Manager container (central tag manager). Required.
NEXT_PUBLIC_GTM_ID=GTM-WR439C6L

# GA4 measurement ID. Configured inside GTM, not loaded directly.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-KZW52G5Z4K

# Google Search Console verification. Provide the token only (the HTML-tag
# method value), never a full <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional marketing integrations. Blank = disabled. Each one only ever loads
# when its id is set AND the visitor has accepted optional cookies.
# Google Ads is configured through GTM + Consent Mode; this id is handed to the
# container via the dataLayer.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_CLARITY_ID=
