# PostgreSQL / Neon (DATABASE_URL takes precedence)
# Never commit a real credential. Copy this file to .env.local and paste your own
# connection string there.
#
# IMPORTANT: leave DATABASE_URL EMPTY unless you have a real one. An unfilled
# placeholder is ignored in favour of NEON_DATABASE_URL, but only because the app
# detects it — the same shape would fail confusingly in any other tool.
DATABASE_URL=
NEON_DATABASE_URL=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919769267792

# Cloudinary (server-only credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend (server-only — never expose these with a NEXT_PUBLIC_ prefix)
RESEND_API_KEY=

# RESEND_FROM_EMAIL must be an address on a domain you have VERIFIED in Resend.
# The default below is Resend's shared test address: it can only ever deliver to
# the Resend account owner's own inbox, so the Rack & Stack team receives enquiry
# notifications but no customer ever receives their acknowledgement.
# Run `npm run mail:check` to confirm the sender is usable.
RESEND_FROM_EMAIL=Rack & Stack <website@your-verified-domain.example>

# Inbox that receives enquiry notifications. Defaults to ADMIN_EMAIL.
INQUIRY_NOTIFICATION_EMAIL=info@rackandstack.in

# Optional contact details printed in the footer of enquiry emails.
# Default to the values below if unset.
RESEND_COMPANY_EMAIL=info@rackandstack.in
RESEND_COMPANY_PHONE=+91 97692 67792
RESEND_COMPANY_ADDRESS=Sr. No. 94/1, Umar Compound, Sopara Phata, Vasai-Virar, Maharashtra 401208

# Initial admin seed
ADMIN_EMAIL=admin@rackandstack.in
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Reserved for additional signing/integration needs
SESSION_SECRET=replace-with-at-least-32-random-characters
